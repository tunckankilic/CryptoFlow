{
  "name": "cryptoflow-alert-checker",
  "version": "0.1.0",
  "private": true,
  "description": "CryptoFlow scheduled alert evaluator Lambda",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@aws-sdk/*",
    "deploy": "./scripts/deploy.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.658.0",
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-sns": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.16.5",
    "aws-sdk-client-mock": "^4.0.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
