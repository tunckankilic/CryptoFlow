# CryptoFlow environment template
# Copy to dev.env / staging.env / prod.env and fill in real values.
# Codemagic builds source the active *.env file and pass each KEY=VALUE
# pair to flutter build via --dart-define.

ENV=dev

# AWS API Gateway (filled after `terraform apply`)
API_BASE_URL=
WS_BASE_URL=

# Binance public API — usually leave as defaults
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_IDENTITY_POOL_ID=
AWS_REGION=eu-central-1
